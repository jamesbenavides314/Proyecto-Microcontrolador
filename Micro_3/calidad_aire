  // Incluye la biblioteca para manejar WiFi en el ESP32
#include <WiFi.h>

// Incluye la biblioteca para crear un servidor web
#include <WebServer.h>

// -------- CONFIGURACIÓN DE LA RED WiFi --------

// Nombre de la red WiFi (SSID)
const char* ssid = "Kta";

// Contraseña de la red WiFi
const char* password = "kta10592";

// -------- CONFIGURACIÓN DEL SENSOR MQ-135 --------

// Define el pin analógico al que está conectado el sensor MQ-135
#define MQ135_PIN 35

// -------- UMBRALES PARA CALIDAD DEL AIRE (en PPM) --------

#define AQ_EXCELLENT 50   // Excelente: menor a 50 PPM
#define AQ_GOOD 100       // Buena: 50-100 PPM
#define AQ_MODERATE 200   // Moderada: 100-200 PPM
#define AQ_POOR 300       // Mala: 200-300 PPM
