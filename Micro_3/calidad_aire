// -------- CREACIÓN DEL SERVIDOR WEB EN PUERTO 80 --------

// Crea un servidor web que atenderá en el puerto HTTP 80
WebServer server(80);

// -------- VARIABLES PARA GUARDAR MÁXIMOS Y MÍNIMOS --------

// Inicializa variables para valor de calidad del aire máximo y mínimo (en PPM)
int airQualityMax = 0, airQualityMin = 500;

// Variable para almacenar el valor actual del sensor en PPM
int airQualityValue = 0;

// Variable para almacenar el estado de la calidad del aire
String airQualityStatus = "Buena";

