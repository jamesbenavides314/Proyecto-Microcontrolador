// -------- FUNCIÓN PARA EVALUAR CALIDAD DEL AIRE --------

void updateAirQuality() {
  // Lee el valor analógico del sensor MQ-135 (rango 0-4095 en ESP32)
  int rawValue = analogRead(MQ135_PIN);
  
  // Mapear valor analógico a PPM (0-4095 -> 0-500 PPM aprox)
  // Nota: Estos valores son aproximados, el MQ135 requiere calibración precisa
  int ppm = map(rawValue, 0, 4095, 0, 500);
  airQualityValue = ppm;
  
  // Determina el estado de calidad del aire según los umbrales
  if (ppm < AQ_EXCELLENT) {
    airQualityStatus = "Excelente";
  } else if (ppm < AQ_GOOD) {
    airQualityStatus = "Buena";
  } else if (ppm < AQ_MODERATE) {
    airQualityStatus = "Moderada";
  } else if (ppm < AQ_POOR) {
    airQualityStatus = "Mala";
  } else {
    airQualityStatus = "Muy Mala";
  }
  
  // Actualiza valores máximos y mínimos
  if (ppm > airQualityMax) airQualityMax = ppm;
  if (ppm < airQualityMin) airQualityMin = ppm;
}

// -------- FUNCIÓN PARA MANEJAR LOS DATOS DEL SENSOR --------

void handleSensorData() {
  // Actualiza los valores del sensor
  updateAirQuality();

  // Construye la respuesta en formato JSON para enviar al navegador
  String json = "{";
  json += "\"ppm\":" + String(airQualityValue) + ",";
  json += "\"status\":\"" + airQualityStatus + "\",";
  json += "\"airQualityMax\":" + String(airQualityMax) + ",";
  json += "\"airQualityMin\":" + String(airQualityMin);
  json += "}";

  // Envía el JSON al navegador como respuesta a la solicitud
  server.send(200, "application/json", json);
}

// -------- FUNCIÓN DE CONFIGURACIÓN (SE EJECUTA UNA VEZ AL INICIO) --------

void setup() {
  // Inicia la comunicación por el puerto serial a 115200 baudios
  Serial.begin(115200);

  // Configura el pin del sensor como entrada
  pinMode(MQ135_PIN, INPUT);

  // Conecta el ESP32 a la red WiFi
  WiFi.begin(ssid, password);

  // Espera hasta que se establezca la conexión WiFi
  while (WiFi.status() != WL_CONNECTED) {
    delay(1000); // Espera 1 segundo
    Serial.println("Conectando a WiFi...");
  }

  // Muestra por consola la IP asignada al ESP32
  Serial.println("Conectado. Dirección IP:");
  Serial.println(WiFi.localIP());

  // Define qué hacer cuando un navegador accede a la raíz "/"
  server.on("/", HTTP_GET, []() {
    server.send_P(200, "text/html", index_html); // Envía el HTML
  });

  // Define qué hacer cuando el navegador pide datos del sensor en "/sensors"
  server.on("/sensors", HTTP_GET, handleSensorData);

  // Inicia el servidor web
  server.begin();

  Serial.println("Servidor web iniciado");
  Serial.println("Calibrando sensor MQ-135...");
  
  // Periodo de precalentamiento del sensor (recomendado: 20-48 horas para mejor precisión)
  // Para pruebas rápidas, 30 segundos es suficiente
  delay(30000);
  
  Serial.println("Sensor listo!");
  Serial.println("Nota: El sensor requiere calibración para mediciones precisas en PPM");
}

// -------- FUNCIÓN PRINCIPAL QUE SE EJECUTA EN BUCLE --------

void loop() {
  // Atiende las peticiones de los clientes que se conecten al servidor web
  server.handleClient();
}
