#include <WiFi.h>
#include <WebServer.h>

const char* ssid = "A33";
const char* password = "27092312";

#define PIN_SENSOR 35


#define LED_INTEGRADO 2

#define UMBRAL_OSCURO 2000  

int nivelLuz = 0;
int luzMax = 0;
int luzMin = 4095;
bool modoOscuro = false;

WebServer server(80);

const char index_html[] PROGMEM = R"rawliteral(
<!DOCTYPE HTML><html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Segoe UI', Tahoma, sans-serif;
      transition: all 0.5s;
      padding: 20px;
      text-align: center;
      min-height: 100vh;
    }
    body.light-mode {
      background: linear-gradient(135deg, #7f7fff, #9d4edd);
      color: white;
    }
    body.dark-mode {
      background: linear-gradient(135deg, #0f0f1a, #1a1b2e);
      color: #e0e0e0;
    }
    h2 { font-size: 2rem; margin-bottom: 20px; }
    .mode-indicator { font-size: 5rem; }
    .container {
      margin: 20px auto;
      padding: 20px;
      background: rgba(255,255,255,0.1);
      border-radius: 20px;
      backdrop-filter: blur(10px);
      max-width: 700px;
    }
    .bar-wrapper { display: flex; justify-content: center; gap: 20px; margin: 30px 0; }
    .bar-container {
      position: relative;
      width: 80px;
      height: 300px;
      background: linear-gradient(to top, #111, #555, #ccc, #eee, #fff);
      border-radius: 40px;
      overflow: hidden;
      border: 3px solid rgba(255,255,255,0.4);
    }
    .bar-mask {
      position: absolute;
      top: 0;
      width: 100%;
      background: rgba(0,0,0,0.7);
      transition: height 0.5s;
    }
    .info-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit,minmax(150px,1fr));
      gap: 15px;
      margin-top: 20px;
    }
    .info-card {
      padding: 15px;
      background: rgba(255,255,255,0.2);
      border-radius: 15px;
      backdrop-filter: blur(5px);
    }
    .info-label { font-size: 0.9rem; opacity: 0.8; }
    .info-value { font-size: 1.8rem; font-weight: bold; }
    .status-message {
      padding: 10px;
      margin-top: 20px;
      border-radius: 10px;
      background: rgba(255,255,255,0.2);
      font-size: 1.2rem;
    }
  </style>
</head>

<body class="light-mode">
  <h2>💡 Sensor de Luz HW-486 - ESP32</h2>
  <div class="mode-indicator" id="mode-icon">☀️</div>

  <div class="container">
    <div class="bar-wrapper">
      <div class="bar-container">
        <div id="light-mask" class="bar-mask" style="height: 100%;"></div>
      </div>
    </div>

    <div class="status-message" id="status-message">Iniciando...</div>

    <div class="info-grid">
      <div class="info-card"><div class="info-label">Nivel Actual</div><div class="info-value" id="light-level">--</div></div>
      <div class="info-card"><div class="info-label">Máximo</div><div class="info-value" id="light-max">--</div></div>
      <div class="info-card"><div class="info-label">Mínimo</div><div class="info-value" id="light-min">--</div></div>
    </div>
  </div>

<script>
function updateData() {
  fetch('/sensors')
    .then(r => r.json())
    .then(data => {
      document.getElementById('light-level').textContent = data.luz;
      document.getElementById('light-max').textContent = data.luzMax;
      document.getElementById('light-min').textContent = data.luzMin;

      let porcentaje = (data.luz / 4095) * 100;
      document.getElementById('light-mask').style.height = (100 - porcentaje) + '%';

      const body = document.body;
      const icon = document.getElementById('mode-icon');
      const msg = document.getElementById('status-message');

      if (data.modoOscuro) {
        body.className = 'dark-mode';
        icon.textContent = '🌙';
        msg.textContent = '🌙 Modo Oscuro - Poca luz';
      } else {
        body.className = 'light-mode';
        icon.textContent = '☀️';
        msg.textContent = '☀️ Modo Claro - Mucha luz';
      }
    });
}

setInterval(updateData, 1000);
window.onload = updateData;
</script>
</body>
</html>
)rawliteral";

void handleSensorData() {

  nivelLuz = analogRead(PIN_SENSOR);

  if (nivelLuz > luzMax) luzMax = nivelLuz;
  if (nivelLuz < luzMin) luzMin = nivelLuz;

  modoOscuro = (nivelLuz > UMBRAL_OSCURO);

  digitalWrite(LED_INTEGRADO, modoOscuro ? HIGH : LOW);

  String json = "{";
  json += "\"luz\":" + String(nivelLuz) + ",";
  json += "\"luzMax\":" + String(luzMax) + ",";
  json += "\"luzMin\":" + String(luzMin) + ",";
  json += "\"modoOscuro\":" + String(modoOscuro ? "true" : "false");
  json += "}";

  server.send(200, "application/json", json);
}

void setup() {
  Serial.begin(115200);

  pinMode(PIN_SENSOR, INPUT);
  pinMode(LED_INTEGRADO, OUTPUT);

  WiFi.begin(ssid, password);
  Serial.print("Conectando a WiFi...");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("\nConectado. IP:");
  Serial.println(WiFi.localIP());

  server.on("/", []() {
    server.send_P(200, "text/html", index_html);
  });

  server.on("/sensors", handleSensorData);

  server.begin();
}

void loop() {
  server.handleClient();

  nivelLuz = analogRead(PIN_SENSOR);
  modoOscuro = (nivelLuz > UMBRAL_OSCURO);
  digitalWrite(LED_INTEGRADO, modoOscuro ? HIGH : LOW);

  delay(100);
}
